# Local development only. Do not use these credentials in production.

# Used by compose.yaml and the Go API.
POSTGRES_DB=vikunja
POSTGRES_USER=vikunja
POSTGRES_PASSWORD=vikunja-dev-password

VIKUNJA_DATABASE_TYPE=postgres
VIKUNJA_DATABASE_HOST=127.0.0.1:5433
VIKUNJA_DATABASE_USER=vikunja
VIKUNJA_DATABASE_PASSWORD=vikunja-dev-password
VIKUNJA_DATABASE_DATABASE=vikunja
VIKUNJA_DATABASE_SSLMODE=disable

VIKUNJA_REDIS_ENABLED=true
VIKUNJA_REDIS_HOST=127.0.0.1:6379
VIKUNJA_REDIS_PASSWORD=
VIKUNJA_REDIS_DB=0
VIKUNJA_KEYVALUE_TYPE=redis

VIKUNJA_SERVICE_INTERFACE=127.0.0.1:3456
VIKUNJA_SERVICE_PUBLICURL=http://localhost:3456/
VIKUNJA_SERVICE_JWTSECRET=local-development-jwt-secret-do-not-use-in-production
VIKUNJA_MAILER_ENABLED=false
VIKUNJA_FILES_BASEPATH=./files
