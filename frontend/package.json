    "happy-dom": "20.11.8",
    "histoire": "1.0.0-beta.1",
    "otplib": "13.5.0",
    "postcss": "8.5.26",
    "postcss-easing-gradients": "3.0.1",
    "postcss-html": "1.8.1",
    "postcss-preset-env": "11.5.0",
    "rollup": "catalog:",
    "rollup-plugin-visualizer": "7.1.1",
    "sass-embedded": "1.103.1",
    "stylelint": "17.14.1",
    "stylelint-config-property-sort-order-smacss": "11.2.0",
