    "@tiptap/vue-3": "3.30.5",
    "@vueuse/core": "14.4.0",
    "@vueuse/router": "14.4.0",
    "axios": "1.20.0",
    "blurhash": "2.0.5",
    "bulma-css-variables": "0.9.33",
    "change-case": "5.4.4",
